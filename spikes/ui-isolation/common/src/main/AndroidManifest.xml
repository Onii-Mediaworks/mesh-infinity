<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into each host app. Three processes:
  - the main process (the stand-in core): UiHostProvider serves the protocol
    socket and grants the UI's policy; no Fibrewall code runs there;
  - ":warden": WardenProvider runs the Fibrewall broker, holding no secrets;
  - ":ui": the host's UI Activity, confined from Application.onCreate
    (each host declares it, and names SpikeApplication as its application).
  Authorities follow the application id, so two hosts never collide.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Not exported: only this app's own processes can call it. -->
        <provider
            android:name="com.oniimediaworks.meshinfinity.uispike.UiHostProvider"
            android:authorities="${applicationId}.host"
            android:exported="false" />

        <!-- The warden: Fibrewall brokers, no secrets. Its own process. -->
        <provider
            android:name="com.oniimediaworks.meshinfinity.uispike.WardenProvider"
            android:authorities="${applicationId}.warden"
            android:process=":warden"
            android:exported="false" />
    </application>
</manifest>
